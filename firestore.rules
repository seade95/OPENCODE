rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Super Admin — full access to everything =====
    match /superAdmin/{doc} {
      allow read: if request.auth != null && (
        request.auth.token.email in get(/databases/$(database)/documents/superAdmin/config).data.email
      );
      allow write: if request.auth != null && (
        request.auth.token.email in get(/databases/$(database)/documents/superAdmin/config).data.email
      );
    }

    // ===== Platform config — readable by all authenticated, writable only by super admin =====
    match /platform/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid in get(/databases/$(database)/documents/superAdmin/config).data.__admins
      );
    }

    // ===== Tenants list — readable by all authenticated, writable by super admin =====
    match /tenants/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email in get(/databases/$(database)/documents/superAdmin/config).data.email
      );
    }

    // ===== Users collection — each user reads/writes their own doc =====
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // ===== Schools — role-based access =====
    match /schools/{schoolId} {
      // Admins can read/write their school
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
      );
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin']
      );

      // Teachers can read their school
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
      );

      // Students can read their school
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
      );
    }

    // ===== Default: deny all =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
