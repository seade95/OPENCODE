rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email == get(/databases/$(database)/documents/superAdmin/config).data.email;
    }

    function isStaffOfSchool(schoolId) {
      return isSignedIn() &&
        userDoc().schoolId == schoolId &&
        userDoc().role in ['admin', 'teacher'];
    }

    function isAdminOfSchool(schoolId) {
      return isSignedIn() &&
        userDoc().schoolId == schoolId &&
        userDoc().role == 'admin';
    }

    function isMemberOfSchool(schoolId) {
      return isSignedIn() && userDoc().schoolId == schoolId;
    }

    // Top-level fields that must NEVER be stored in the public
    // tenants directory (it is readable by anyone, including
    // anonymous homepage visitors). Nested sanitization (stripping
    // adminPass/adminEmail from each tenant object) is done by the
    // super-admin client in sanitizeTenantsForCloud() before write —
    // rules cannot deep-scan arrays, and writes are super-admin
    // only, so the client strip is the trusted path.
    function tenantsAreSanitized(data) {
      return !data.keys().hasAny(['adminPass', 'adminEmail', 'password', 'applications']);
    }

    // Fields that must NEVER be stored in schoolsPublic — the
    // public landing-page projection of a school (students,
    // staff records, credentials, payment settings…).
    function publicSchoolIsSanitized(data) {
      return !data.keys().hasAny([
        'admins', 'adminPass', 'adminEmail', 'password',
        'students', 'teachers', 'staff', 'staffRecords', 'salaryRecords',
        'fees', 'paymentConfig', 'paymentSecrets', 'smtpConfig',
        'bankAccounts', 'apiKeys', 'secrets'
      ]);
    }

    // ============================================================
    // superAdmin/config — platform owner only
    // ============================================================
    match /superAdmin/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // ============================================================
    // platform/config — auth-only read (contains SMTP password and
    // bank account details); only super admin may write. Anonymous
    // homepage visitors fall back to getDefaultPlatformConfig().
    // ============================================================
    match /platform/{doc} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // tenants/list — public directory of schools. PUBLIC read so an
    // anonymous visitor on the homepage can resolve ?school=slug.
    // Writes are super-admin only AND must be sanitized (no
    // adminPass/adminEmail/applications inside a world-readable doc).
    // ============================================================
    match /tenants/{doc} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && tenantsAreSanitized(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // schoolsPublic/{schoolId} — sanitized projection of a school
    // used by the public landing page (profile, gallery, branding,
    // announcements…). PUBLIC read; only staff of that school (or
    // super admin) may write, and only with sensitive fields absent.
    // ============================================================
    match /schoolsPublic/{schoolId} {
      allow read: if true;
      allow create, update: if
        (isStaffOfSchool(schoolId) || isSuperAdmin()) &&
        publicSchoolIsSanitized(request.resource.data);
      allow delete: if isStaffOfSchool(schoolId) || isSuperAdmin();
    }

    // ============================================================
    // applications/list — school applications submitted from the
    // public "Apply for a School" flow. Super admin only (public
    // submissions stay device-local in localStorage until an admin
    // signs in, which avoids world-writable spam vectors).
    // ============================================================
    match /applications/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // ============================================================
    // users/{userId} — each user manages their own profile.
    // Staff within the same school can read each other's profile
    // (needed for admin dashboards / staff directories).
    // schoolId and role are NEVER client-settable after creation
    // by anyone except an admin of that school or super admin —
    // this stops a user from promoting themselves to 'admin'.
    // ============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isMemberOfSchool(resource.data.schoolId) ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.schoolId == resource.data.schoolId) ||
        isAdminOfSchool(resource.data.schoolId) ||
        isSuperAdmin()
      );

      allow delete: if isAdminOfSchool(resource.data.schoolId) || isSuperAdmin();
    }

    // ============================================================
    // schools/{schoolId} — the main per-school data document
    // (students, teachers, fees, results, etc. all live inside
    // this one document today). Staff-only read/write; the public
    // landing page uses schoolsPublic/{schoolId} instead.
    //
    // NOTE: this is a whole-document model — any staff member of
    // the school gets read/write to the ENTIRE doc, including
    // fields a teacher shouldn't be able to touch (e.g. other
    // staff salaries, payment settings). That's a schema-level
    // limitation, not something rules alone can fix. Splitting
    // `schools/{schoolId}` into subcollections (students/, fees/,
    // staffHR/, etc.) with per-collection rules is the real fix —
    // flagged separately, out of scope for this pass.
    // ============================================================
    match /schools/{schoolId} {
      allow read: if isMemberOfSchool(schoolId) || isSuperAdmin();
      allow write: if
        isStaffOfSchool(schoolId) ||
        isSuperAdmin() ||
        // Students/parents may write only to user-facing fields
        (isMemberOfSchool(schoolId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'submissions', 'notifications', 'maintenanceReqs', 'library',
            'storeOrders', 'forumPosts', 'messages', 'activityLog',
            'currentLanguage', 'waitlists', '_version'
          ])
        ));
    }

    // ============================================================
    // paymentSecrets/{schoolId} — payment gateway SECRET keys.
    // No client, ever, under any role, may read or write this
    // collection directly. Only the Firebase Admin SDK (i.e. your
    // Cloud Functions) can touch it, because Admin SDK calls
    // bypass these rules entirely. This is intentional: secret
    // keys must never reach the browser.
    // ============================================================
    match /paymentSecrets/{schoolId} {
      allow read, write: if false;
    }

    // ============================================================
    // Deny everything else by default
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
