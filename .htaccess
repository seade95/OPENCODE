# EDUVERSE - Root Domain Redirection
# Apache configuration — place in the root directory

# Enable RewriteEngine
RewriteEngine On

# Serve index.html as the root directory index
DirectoryIndex index.html

# Route /superadmin to superadmin.html
RewriteRule ^superadmin/?$ /superadmin.html [L]

# Redirect all requests to index.html unless the file or directory exists
# This ensures clean SPA routing (e.g., /login, /admin, /student serve index.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Force HTTPS (uncomment when SSL certificate is installed)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www prefix (uncomment to force non-www)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Caching headers for static assets
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML should not be cached aggressively (served fresh)
<FilesMatch "\.(html)$">
  Header set Cache-Control "private, no-cache, must-revalidate"
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny access to hidden files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Deny access to sensitive files
<FilesMatch "(^#|~$|\.bak$|\.swp$|\.sql$|\.log$)">
  Require all denied
</FilesMatch>
